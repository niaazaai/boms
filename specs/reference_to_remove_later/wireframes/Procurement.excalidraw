      "locked": false,
      "index": "bZb",
      "frameId": null
    },
    {
      "id": "iM21jTEvzKZ8DDadMZ1MV",
      "type": "text",
      "x": 6011.9850492443275,
      "y": 2089.1513064758433,
      "width": 502.4754333496094,
      "height": 149.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 1084108811,
      "version": 40,
      "versionNonce": 1712528997,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1766644313813,
      "link": null,
      "locked": false,
      "text": "1) Demand Trigger (forecast/orders/min stock)\n2) Create Production Job/Order (product, planned qty, schedule, line)\n3) Material Request (direct + indirect) from inventory\n4) Inventory issues materials (stock-out) → Production receives\n5) Production cycles/batches per shift (output, scrap, labor)\n6) QC inspection (pass/fail, rework)\n7) Post finished goods output → Transfer to warehouse\n8) Close job & cost (materials + labor + overhead)\n\nBatteries: usually Receiving → QC → Stock-in → Sale (unless repack/relabel).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": "bUQm-jHOPhiESmCgfJp0b",
      "originalText": "1) Demand Trigger (forecast/orders/min stock)\n2) Create Production Job/Order (product, planned qty, schedule, line)\n3) Material Request (direct + indirect) from inventory\n4) Inventory issues materials (stock-out) → Production receives\n5) Production cycles/batches per shift (output, scrap, labor)\n6) QC inspection (pass/fail, rework)\n7) Post finished goods output → Transfer to warehouse\n8) Close job & cost (materials + labor + overhead)\n\nBatteries: usually Receiving → QC → Stock-in → Sale (unless repack/relabel).",
      "lineHeight": 1.15,
      "index": "bZc",
      "frameId": null,
      "roundness": null,
      "autoResize": true
    },
