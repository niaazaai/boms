    inventory_stock_transactions            -- THE immutable stock ledger
        id (PK)
        tenant_id                   FK tenants(id)
        transaction_number          varchar(100)            -- TRN26-000001
        business_date               date not null
        inventory_item_id           FK inventory_items(id)
        warehouse_id                FK warehouses(id)
        branch_id                   FK branches(id)

        type                        enum(
                                        'stock_in',      -- receipt / manual / sale-return restock
                                        'stock_out',     -- sale complete / supplier return
                                        'adjustment',    -- count correction (+/−)
                                        'transfer_in',
                                        'transfer_out',
                                        'rent_out',      -- dress left the shop with a customer
                                        'rent_return',   -- dress came back
                                        'dispose'        -- write-off (always negative)
                                    )
                                    -- REMOVED in v2: 'reserve', 'release'.   [B2]
                                    -- Reservations are not stock movements.

        quantity                    numeric(18,3) not null
            -- positive: stock_in, transfer_in, rent_return, adjustment+
            -- negative: stock_out, transfer_out, rent_out, dispose, adjustment−

        unit_cost                   numeric(18,2) default 0
            -- stock_in  → landed_unit_cost of the source document
            -- stock_out → WAC snapshot at the moment of posting
        currency_id                 FK currencies(id)
        exchange_rate               numeric(18,6) default 1
        amount_base                 numeric(18,2)   -- signed: quantity × unit_cost × rate

        reference_type              varchar(50)
            -- procurement_receipt | inventory_stock_entry | inventory_adjustment
            -- | inventory_disposal | inventory_transfer | sales_order
            -- | sales_sale_return | sales_rental_claim | procurement_return
        reference_id                bigint nullable
        note                        text

        reverses_id                 FK inventory_stock_transactions(id) nullable
        created_by / created_at
        -- unique (tenant_id, transaction_number)                             [A1]
        -- IMMUTABLE after insert. Corrections are reversing transactions.    [ADR-005]
        -- index (tenant_id, inventory_item_id, warehouse_id, business_date)
        -- index (tenant_id, reference_type, reference_id)


