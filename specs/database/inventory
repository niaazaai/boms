    inventory_items
        id (PK)
        tenant_id                   FK tenants(id)
        sku                         varchar(100) not null   -- ADF26-0042
        name                        varchar(255) not null
        barcode                     varchar(100) nullable

        main_category_id            FK inventory_main_categories(id)
        sub_category_id             FK inventory_sub_categories(id)
        item_type_id                FK inventory_item_types(id)
        item_model_id               FK inventory_item_models(id)

        -- Bridal attributes
        size                        varchar(30)             -- S, M, L, 38, 40
        color                       varchar(50)
        fabric                      varchar(100)
        season                      varchar(50)
        purpose                     enum('sale','rental','both') default 'both'
        quality                     enum('high','medium','normal','low') default 'normal'
        description                 text
        components                  text                    -- pieces included with the dress
        custom_fields               jsonb

        -- Stock policy
        is_serialised               boolean default true
            -- true  = one physical dress, qty 1 (the usual bridal case)
            -- false = fungible accessories with qty > 1
        reorder_level               numeric(18,3) default 0
        default_warehouse_id        FK warehouses(id) nullable
            -- FORM CONVENIENCE ONLY. Stock location lives in the ledger and
            -- inventory_stock_balances — an item may hold stock in many
            -- warehouses at once.                                            [B5]

        -- Sales pricing
        sales_currency_id           FK currencies(id)
        sales_unit_price            numeric(18,2) default 0
        sales_unit_id               FK units(id)

        -- Rental pricing & cost recovery
        rental_currency_id          FK currencies(id)
        rental_price                numeric(18,2) default 0     -- per rental period
        rental_period_days          int default 3
        rental_deposit_amount       numeric(18,2) default 0
        rental_late_fee_per_day     numeric(18,2) default 0
        rental_buffer_days          int nullable                -- overrides tenant setting  [B7]
        expected_rental_uses        int nullable                -- overrides tenant default  (ADR-002)
        amortised_cost_to_date      numeric(18,2) default 0
            -- accumulates rental_amortisation; capped at acquisition cost.
            -- Once capped the dress has paid for itself → further rentals carry 0 COGS.

        -- Display-only cost reference (NOT used for valuation — see ADR-001)
        last_purchase_cost          numeric(18,2) default 0
        last_purchase_date          date
        acquisition_cost            numeric(18,2) default 0     -- basis for amortisation

        lifecycle_status            enum('active','repairing','discontinued','disposed')
                                    default 'active'
            -- STORED. This is a property of the item record.                 [B1]
            -- Availability (available / reserved / rented / out_of_stock) is
            -- DERIVED from quantities and is NEVER stored.
        repair_note                 varchar(512)

        created_by / updated_by / created_at / updated_at
        -- unique (tenant_id, sku)                                            [A1]
        -- unique (tenant_id, barcode) where barcode is not null
