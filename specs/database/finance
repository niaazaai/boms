    finance_payables                        -- Pillar 4 · THE source of A/P    [D4]
        id (PK)
        tenant_id                   FK tenants(id)
        payable_number              varchar(100)            -- AP26-0001
        supplier_id                 FK procurement_suppliers(id)
        purchase_order_id           FK procurement_purchase_orders(id) nullable
        receipt_id                  FK procurement_receipts(id) nullable
        invoice_no                  varchar(100)
        issue_date                  date not null
        due_date                    date
        business_date               date not null
        currency_id                 FK currencies(id)
        exchange_rate               numeric(18,6) default 1
        original_amount             numeric(18,2) not null
        original_amount_base        numeric(18,2) not null
        paid_amount                 numeric(18,2) default 0
        balance_amount              numeric(18,2) not null
        balance_amount_base         numeric(18,2) not null
        status                      enum('open','partial','paid','void') default 'open'
        note                        text
        reverses_id                 FK finance_payables(id) nullable
        created_by / updated_by / created_at / updated_at
        -- unique (tenant_id, payable_number)
        -- Opened by procurement_receipts on post; reduced by supplier payments
        -- and supplier returns. procurement_purchase_orders.cached_balance_amount
        -- mirrors this for display and is never summed for the A/P pillar.
        -- index (tenant_id, status, due_date) → aging buckets


    finance_receivables                     -- Pillar 5 · THE source of A/R    [C8]
        id (PK)
        tenant_id                   FK tenants(id)
        receivable_number           varchar(100)            -- AR26-0001
        customer_id                 FK sales_customers(id)
        sales_order_id              FK sales_orders(id) nullable
        rental_claim_id             FK sales_rental_claims(id) nullable
        issue_date                  date not null
        due_date                    date
        business_date               date not null
        currency_id                 FK currencies(id)
        exchange_rate               numeric(18,6) default 1
        original_amount             numeric(18,2) not null
        original_amount_base        numeric(18,2) not null
        paid_amount                 numeric(18,2) default 0
        balance_amount              numeric(18,2) not null
        balance_amount_base         numeric(18,2) not null
        status                      enum('open','partial','paid','void') default 'open'
        note                        text
        reverses_id                 FK finance_receivables(id) nullable
        created_by / updated_by / created_at / updated_at
        -- unique (tenant_id, receivable_number)
        -- Opened when an order completes with a balance, or by a rental claim.
        -- sales_orders.cached_balance_amount mirrors this for display only.
        -- index (tenant_id, status, due_date) → aging buckets


    finance_daily_summaries                 -- CACHE for fast dashboard history
        id (PK)
        tenant_id                   FK tenants(id)
        summary_date                date not null           -- business_date
        branch_id                   FK branches(id) nullable  -- null = all branches

        cash_balance                numeric(18,2) default 0
        deposits_held               numeric(18,2) default 0   -- liability inside cash  [E4]
        owner_cash                  numeric(18,2) default 0   -- cash − deposits_held

        income_total                numeric(18,2) default 0
        expense_total               numeric(18,2) default 0
        cogs_sale_total             numeric(18,2) default 0
        cogs_rental_amortisation    numeric(18,2) default 0
        gross_profit                numeric(18,2) default 0   -- income − total COGS
        net_profit                  numeric(18,2) default 0   -- gross − expenses

        receivables_balance         numeric(18,2) default 0
        payables_balance            numeric(18,2) default 0
        inventory_worth             numeric(18,2) default 0   -- owned_qty × avg_cost

        sales_count                 int default 0
        rental_count                int default 0
        is_stale                    boolean default false                     -- [E7]
            -- set true whenever any posting lands on a covered business_date;
            -- recomputed on read or by a nightly job. NEVER a source of truth.
        computed_at                 timestamptz
        created_at
        -- unique (tenant_id, summary_date, branch_id)
        -- All amounts in tenant default currency.


    -- REPORTING VIEWS (documented for implementers)
    -- finance_profit_and_loss (period, branch):
    --     Revenue      : sale revenue + rental revenue + late fees
    --                    + forfeited deposits + other income
    --     COGS         : sale_cogs + rental_amortisation
    --     Gross profit : Revenue − COGS
    --     Expenses     : by category
    --     Net profit   : Gross profit − Expenses
    -- finance_ap_aging / finance_ar_aging: current | 1-30 | 31-60 | 60+
    -- finance_deposit_register: per order — taken, applied, forfeited,
    --     refunded, held; total reconciles to the dashboard deposits tile.


