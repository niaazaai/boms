2. FINANCE-CORE MODULE
   (built BEFORE inventory/sales/procurement — they all post into it)     [A4]
----------------------------------------------------------------------------------


    finance_accounts
        id (PK)
        tenant_id                   FK tenants(id)
        code                        varchar(30)             -- CASH-MAIN, BANK-AZIZI
        name                        varchar(150) not null
        account_type                enum('cash','bank','wallet','other') default 'cash'
        currency_id                 FK currencies(id)
        opening_balance             numeric(18,2) default 0
        cached_balance              numeric(18,2) default 0
            -- CACHE ONLY. Truth = opening_balance + Σ posted finance_transactions.
            -- Refreshed inside the posting transaction; a nightly job compares
            -- cached vs computed and raises a reconcile_mismatch notification.  [E1]
        cached_balance_at           timestamptz
        branch_id                   FK branches(id) nullable
        is_default                  boolean default false
        status                      enum('active','inactive') default 'active'
        created_by / updated_by / created_at / updated_at
        -- unique (tenant_id, code)


    finance_categories
        id (PK)
        tenant_id                   FK tenants(id)
        kind                        enum('income','expense') not null
        code                        varchar(30)
        name                        varchar(150) not null
        parent_id                   FK finance_categories(id) nullable
        is_system                   boolean default false
        status                      enum('active','inactive') default 'active'
        created_by / updated_by / created_at / updated_at
        -- unique (tenant_id, code)
        -- Seeded income:  dress_sale, rental_fee, late_fee, forfeited_deposit, other_income
        -- Seeded expense: shop_rent, salaries, utilities, dry_cleaning, repair,
        --                 marketing, transport, bank_fees, other_expense


    finance_transactions                    -- THE unified money ledger       [E2]
        id (PK)
        tenant_id                   FK tenants(id)
        transaction_number          varchar(100)            -- FIN26-000001
        business_date               date not null
        transaction_date            date not null
        direction                   enum('in','out') not null
        amount                      numeric(18,2) not null
        currency_id                 FK currencies(id)
        exchange_rate               numeric(18,6) default 1
        amount_base                 numeric(18,2) not null  -- tenant default currency

        finance_account_id          FK finance_accounts(id) not null
        category_id                 FK finance_categories(id) nullable
        payment_method_id           FK payment_methods(id)

        reference_type              varchar(50)
            -- sales_order_payment | sales_sale_return | sales_rental_claim
            -- | procurement_supplier_payment | procurement_return
            -- | finance_expense | finance_other_income | finance_account_transfer
            -- | customer_deposit | opening
        reference_id                bigint nullable

        counterparty_type           enum('customer','supplier','staff','other','none') default 'none'
        counterparty_id             bigint nullable
        counterparty_name           varchar(255)

        is_deposit_movement         boolean default false
            -- true → affects Cash and the deposit liability, NOT Income.     [C1]

        branch_id                   FK branches(id)
        note                        text
        status                      enum('posted','void') default 'posted'
        reverses_id                 FK finance_transactions(id) nullable
        idempotency_key             uuid
        created_by / updated_by / created_at / updated_at
        -- unique (tenant_id, transaction_number)                             [A1]
        -- unique (tenant_id, idempotency_key)                                [A5]
        -- Void = insert a mirrored reversing row; never edit, never delete.  [E5]
        -- index (tenant_id, business_date, status), (tenant_id, finance_account_id)


    finance_customer_deposits              -- NEW · liability register   [C1][E4]
        id (PK)
        tenant_id                   FK tenants(id)
        deposit_number              varchar(100)            -- DEP26-0001
        sales_order_id              FK sales_orders(id)
        customer_id                 FK sales_customers(id)
        currency_id                 FK currencies(id)
        exchange_rate               numeric(18,6) default 1

        taken_amount                numeric(18,2) not null  -- received from customer
        applied_amount              numeric(18,2) default 0 -- applied to the final balance
        forfeited_amount            numeric(18,2) default 0 -- kept for damage / late → INCOME
        refunded_amount             numeric(18,2) default 0 -- returned to customer
        held_amount                 numeric(18,2) not null
            -- = taken − applied − forfeited − refunded. The liability balance.

        status                      enum('held','partially_settled','settled') default 'held'
        business_date               date not null
        note                        text
        created_by / updated_by / created_at / updated_at
        -- unique (tenant_id, deposit_number)
        -- Pillar 1 shows: cash total, of which deposits held, and "your cash".


    finance_cogs_entries                   -- NEW · cost of goods   [C2][E6]
        id (PK)
        tenant_id                   FK tenants(id)
        entry_number                varchar(100)            -- COGS26-000001
        business_date               date not null
        kind                        enum('sale_cogs','rental_amortisation') not null
        sales_order_id              FK sales_orders(id)
        sales_order_item_id         FK sales_order_items(id)
        inventory_item_id           FK inventory_items(id)
        quantity                    numeric(18,3) not null
        unit_cost                   numeric(18,2) not null
            -- sale_cogs          → WAC at the moment of stock_out
            -- rental_amortisation → item.purchase_cost / expected_rental_uses  (ADR-002)
        amount                      numeric(18,2) not null
        currency_id                 FK currencies(id)
        exchange_rate               numeric(18,6) default 1
        amount_base                 numeric(18,2) not null
        branch_id                   FK branches(id)
        status                      enum('posted','void') default 'posted'
        reverses_id                 FK finance_cogs_entries(id) nullable
        created_by / created_at
        -- unique (tenant_id, entry_number)
        -- Written when a sale completes or a rental completes. No cash moves —
        -- this is why COGS cannot live in finance_transactions.
        -- index (tenant_id, business_date, kind)


    finance_account_transfers
        id (PK)
        tenant_id                   FK tenants(id)
        transfer_number             varchar(100)            -- FTR26-0001
        business_date               date not null
        transfer_date               date not null
        from_account_id             FK finance_accounts(id)
        to_account_id               FK finance_accounts(id)
        amount                      numeric(18,2) not null
        currency_id                 FK currencies(id)
        exchange_rate               numeric(18,6) default 1
        amount_base                 numeric(18,2) not null
        note                        text
        status                      enum('posted','void') default 'posted'
        reverses_id                 FK finance_account_transfers(id) nullable
        idempotency_key             uuid
        created_by / created_at
        -- unique (tenant_id, transfer_number)
        -- Posts TWO finance_transactions (out of from_account, in to to_account),
        -- both with category_id NULL so they never touch Income or Expenses.
