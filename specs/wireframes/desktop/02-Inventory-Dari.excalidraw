  {
   "id": "5v0PD0AULfKaoP6wbuVU",
   "type": "text",
   "x": 4720,
   "y": 8368,
   "width": 1112,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
