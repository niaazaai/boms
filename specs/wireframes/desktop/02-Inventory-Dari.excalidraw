   "link": null,
   "locked": false,
   "seed": 305960608,
   "text": "\u0647\u0640\u06f2.  \u0627\u0646\u062a\u0642\u0627\u0644 \u062c\u062f\u06cc\u062f \u2014 \u06a9\u0634\u0648 \u0631\u0648\u06cc \u0641\u0647\u0631\u0633\u062a \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "right",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u0647\u0640\u06f2.  \u0627\u0646\u062a\u0642\u0627\u0644 \u062c\u062f\u06cc\u062f \u2014 \u06a9\u0634\u0648 \u0631\u0648\u06cc \u0641\u0647\u0631\u0633\u062a \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "auto": true
   }
  },
