   "link": null,
   "locked": false,
   "seed": 1542201062,
   "text": "Condition shots live in platform_attachments against the\nrental order or the claim \u2014 they prove what the dress\nlooked like when it left and when it came back.\nThey are deliberately NOT in the catalogue gallery.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Condition shots live in platform_attachments against the\nrental order or the claim \u2014 they prove what the dress\nlooked like when it left and when it came back.\nThey are deliberately NOT in the catalogue gallery.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
