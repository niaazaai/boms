   "text": "\u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0648\u062c\u0648\u062f\u06cc \u0645\u06cc\u0627\u0646 \u0627\u0646\u0628\u0627\u0631\u0647\u0627 \u06cc\u0627 \u0634\u0639\u0628\u0647\u200c\u0647\u0627. \u0642\u06cc\u0645\u062a \u0647\u0645\u0631\u0627\u0647 \u0645\u0627\u0644 \u062d\u0631\u06a9\u062a \u0645\u06cc\u200c\u06a9\u0646\u062f.",
