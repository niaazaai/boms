   "y": 7700,
   "width": 432.4800000000001,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#0f172a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
