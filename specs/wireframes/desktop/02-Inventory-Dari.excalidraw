  {
   "id": "DwTXicusSBbxa5INmsPp",
   "type": "text",
   "x": 1596.0000000000002,
   "y": 4868,
   "width": 359.68,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#d97706",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
