  {
   "id": "WDhERlbOVDg0w7Ix-hb1",
   "type": "text",
   "x": 1997.12,
   "y": 4868,
   "width": 446.88000000000005,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#7c3aed",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
