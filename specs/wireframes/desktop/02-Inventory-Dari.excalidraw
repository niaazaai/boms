   "link": null,
   "locked": false,
   "seed": 1303185157,
   "text": "STORAGE\nfile_path is a key in object storage, not a blob.\ntitle \u00b7 sort_order \u00b7 is_main are the only metadata.\nDeleting the is_main photo promotes the next by sort_order.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "STORAGE\nfile_path is a key in object storage, not a blob.\ntitle \u00b7 sort_order \u00b7 is_main are the only metadata.\nDeleting the is_main photo promotes the next by sort_order.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
  {
   "id": "vVJMTeoyybjBN4s6FFpt",
   "type": "rectangle",
   "x": 28,
   "y": 3026,
   "width": 1136,
   "height": 71,
   "angle": 0,
   "strokeColor": "#0d9488",
