   "link": null,
   "locked": false,
   "seed": 1786268631,
   "text": "IMMUTABLE IDENTITY\nsku and barcode have no rows in this table because they\ncannot change after creation. If a tag is damaged, Reprint\nlabel re-renders the same Code 128 and QR \u2014 it never reissues.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "IMMUTABLE IDENTITY\nsku and barcode have no rows in this table because they\ncannot change after creation. If a tag is damaged, Reprint\nlabel re-renders the same Code 128 and QR \u2014 it never reissues.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
