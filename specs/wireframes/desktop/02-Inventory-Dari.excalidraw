   "text": "\u0628\u06f7.  \u067e\u0631\u0648\u0641\u0627\u06cc\u0644 \u0642\u0644\u0645 \u00b7 \u06a9\u0631\u0627\u06cc\u0647\u200c\u0647\u0627 \u2014 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647\u060c \u0639\u0627\u06cc\u062f\u060c \u0628\u0627\u0632\u06af\u0634\u062a \u0633\u0631\u0645\u0627\u06cc\u0647",
