   "text": "RECONCILIATION\n\u03a3 stock-in  AFN 684,200\n\u2212  \u03a3 stock-out  AFN 402,850\n=  net change  AFN 281,350  \u2713 matches the\n   inventory balance movement for the period.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "RECONCILIATION\n\u03a3 stock-in  AFN 684,200\n\u2212  \u03a3 stock-out  AFN 402,850\n=  net change  AFN 281,350  \u2713 matches the\n   inventory balance movement for the period.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
