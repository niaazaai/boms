   "text": "\u26a0  \u067e\u06cc\u0631\u0627\u0647\u0646 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u062a\u0627\u0631\u06cc\u062e\u200c\u0647\u0627 \u0642\u0628\u0644\u0627\u064b \u0631\u0632\u0631\u0648 \u0634\u062f\u0647",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "right",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u26a0  \u067e\u06cc\u0631\u0627\u0647\u0646 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u062a\u0627\u0631\u06cc\u062e\u200c\u0647\u0627 \u0642\u0628\u0644\u0627\u064b \u0631\u0632\u0631\u0648 \u0634\u062f\u0647",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "Nx3Ov8cO7xfkb9pUZhKV",
   "type": "text",
   "x": 3574.0,
   "y": 6995.0,
   "width": 532,
   "height": 130.0,
   "angle": 0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "m5hHbMwZkA-VcQn33X21"
   ],
   "frameId": null,
   "index": "a0",
   "roundness": null,
   "version": 1,
   "versionNonce": 970835329,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789469969945,
   "link": null,
   "locked": false,
   "seed": 815655346,
   "text": "\u067e\u06cc\u0631\u0627\u0647\u0646 \u0633\u0641\u06cc\u062f \u0627\u06cc\u200c\u0644\u0627\u06cc\u0646 (ADF26-0042) \u0627\u0632 \u06f2\u06f4 \u062a\u0627 \u06f2\u06f6 \u0633\u067e\u062a\u0645\u0628\u0631 \u0628\u0631\u0627\u06cc SO26-000470 \u0631\u0632\u0631\u0648 \u0627\u0633\u062a\n\u0648 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u06f2 \u0631\u0648\u0632 \u0645\u0647\u0644\u062a \u067e\u0627\u06a9\u200c\u06a9\u0627\u0631\u06cc \u062a\u0627 \u06f2\u06f8 \u0633\u067e\u062a\u0645\u0628\u0631 \u0645\u0633\u062f\u0648\u062f \u0645\u06cc\u200c\u0628\u0627\u0634\u062f.\n\u062a\u0646\u0647\u0627 \u06f1 \u0648\u0627\u062d\u062f \u062f\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u0631\u06a9\u0632\u06cc \u0645\u0648\u062c\u0648\u062f \u0627\u0633\u062a\u060c \u067e\u0633 \u062f\u0648\u0628\u0627\u0631\u0647 \u0631\u0632\u0631\u0648 \u0634\u062f\u0647 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f.\n\n\u06af\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u0634\u0645\u0627:\n   \u2022 \u0647\u0645\u06cc\u0646 \u067e\u06cc\u0631\u0627\u0647\u0646 \u0631\u0627 \u0627\u0632 \u0634\u0639\u0628\u0647 \u0634\u0647\u0631 \u0646\u0648 \u0628\u06af\u06cc\u0631\u06cc\u062f \u2014 \u06f1 \u0642\u0627\u0628\u0644 \u062f\u0633\u062a\u0631\u0633\n   \u2022 \u0631\u0632\u0631\u0648 \u0631\u0627 \u0628\u0647 \u06f2\u06f9 \u0633\u067e\u062a\u0645\u0628\u0631 \u06cc\u0627 \u0628\u0639\u062f \u0627\u0632 \u0622\u0646 \u0627\u0646\u062a\u0642\u0627\u0644 \u062f\u0647\u06cc\u062f\n   \u2022 \u067e\u06cc\u0631\u0627\u0647\u0646 \u0645\u0627\u0647\u06cc\u200c\u062f\u0645 \u0639\u0627\u062c\u06cc  ADF26-0088  \u0633\u0627\u06cc\u0632 S \u0631\u0627 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u06a9\u0646\u06cc\u062f",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "right",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u067e\u06cc\u0631\u0627\u0647\u0646 \u0633\u0641\u06cc\u062f \u0627\u06cc\u200c\u0644\u0627\u06cc\u0646 (ADF26-0042) \u0627\u0632 \u06f2\u06f4 \u062a\u0627 \u06f2\u06f6 \u0633\u067e\u062a\u0645\u0628\u0631 \u0628\u0631\u0627\u06cc SO26-000470 \u0631\u0632\u0631\u0648 \u0627\u0633\u062a\n\u0648 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u06f2 \u0631\u0648\u0632 \u0645\u0647\u0644\u062a \u067e\u0627\u06a9\u200c\u06a9\u0627\u0631\u06cc \u062a\u0627 \u06f2\u06f8 \u0633\u067e\u062a\u0645\u0628\u0631 \u0645\u0633\u062f\u0648\u062f \u0645\u06cc\u200c\u0628\u0627\u0634\u062f.\n\u062a\u0646\u0647\u0627 \u06f1 \u0648\u0627\u062d\u062f \u062f\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u0631\u06a9\u0632\u06cc \u0645\u0648\u062c\u0648\u062f \u0627\u0633\u062a\u060c \u067e\u0633 \u062f\u0648\u0628\u0627\u0631\u0647 \u0631\u0632\u0631\u0648 \u0634\u062f\u0647 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f.\n\n\u06af\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u0634\u0645\u0627:\n   \u2022 \u0647\u0645\u06cc\u0646 \u067e\u06cc\u0631\u0627\u0647\u0646 \u0631\u0627 \u0627\u0632 \u0634\u0639\u0628\u0647 \u0634\u0647\u0631 \u0646\u0648 \u0628\u06af\u06cc\u0631\u06cc\u062f \u2014 \u06f1 \u0642\u0627\u0628\u0644 \u062f\u0633\u062a\u0631\u0633\n   \u2022 \u0631\u0632\u0631\u0648 \u0631\u0627 \u0628\u0647 \u06f2\u06f9 \u0633\u067e\u062a\u0645\u0628\u0631 \u06cc\u0627 \u0628\u0639\u062f \u0627\u0632 \u0622\u0646 \u0627\u0646\u062a\u0642\u0627\u0644 \u062f\u0647\u06cc\u062f\n   \u2022 \u067e\u06cc\u0631\u0627\u0647\u0646 \u0645\u0627\u0647\u06cc\u200c\u062f\u0645 \u0639\u0627\u062c\u06cc  ADF26-0088  \u0633\u0627\u06cc\u0632 S \u0631\u0627 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u06a9\u0646\u06cc\u062f",
