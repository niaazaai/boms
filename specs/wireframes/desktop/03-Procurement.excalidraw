   "seed": 1158076929,
   "text": "RECONCILIATION \u2014 opening stock value 01 Sep 4,812,000.00 + stock-ins 678,000.00 \u2212 stock-outs 486,300.00 = closing 5,003,700.00 \u00b7 \u03a3 stock-in rows = inventory increase \u00b7 variance AFN 0.00  \u2713",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "RECONCILIATION \u2014 opening stock value 01 Sep 4,812,000.00 + stock-ins 678,000.00 \u2212 stock-outs 486,300.00 = closing 5,003,700.00 \u00b7 \u03a3 stock-in rows = inventory increase \u00b7 variance AFN 0.00  \u2713",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "9lmLcyojMpfqo1CGJqh4",
