  {
   "id": "sRNgDQDR1VVGibepvgV0",
   "type": "text",
   "x": 3132,
   "y": 4754,
   "width": 1416,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#2563eb",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0",
   "roundness": null,
   "version": 1,
   "versionNonce": 2001738167,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 2107224552,
   "text": "THE report the brief asked for. Source = inventory_stock_transactions WHERE quantity > 0 AND type IN (stock_in, transfer_in, rent_return, adjustment+), grouped by reference_type.\nValue = quantity \u00d7 unit_cost \u00d7 exchange_rate \u2014 for purchase rows unit_cost IS the landed_unit_cost stored on procurement_receipt_items, so this report ties exactly to the purchase register.\nSource document deep-links to GRN / manual entry / sales return / rental return / transfer. Voided receipts appear as their reversing negative rows, so the totals self-correct.\nReconciliation line proves \u03a3 stock-ins \u2212 \u03a3 stock-outs = closing \u2212 opening valuation; a non-zero variance means someone mutated stock outside the ledger (defect D5).",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "THE report the brief asked for. Source = inventory_stock_transactions WHERE quantity > 0 AND type IN (stock_in, transfer_in, rent_return, adjustment+), grouped by reference_type.\nValue = quantity \u00d7 unit_cost \u00d7 exchange_rate \u2014 for purchase rows unit_cost IS the landed_unit_cost stored on procurement_receipt_items, so this report ties exactly to the purchase register.\nSource document deep-links to GRN / manual entry / sales return / rental return / transfer. Voided receipts appear as their reversing negative rows, so the totals self-correct.\nReconciliation line proves \u03a3 stock-ins \u2212 \u03a3 stock-outs = closing \u2212 opening valuation; a non-zero variance means someone mutated stock outside the ledger (defect D5).",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "bG9zJenGRGJB_Kbwb_kb",
