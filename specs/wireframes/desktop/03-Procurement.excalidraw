   "seed": 127288880,
   "text": "INSERT / UPDATE procurement_suppliers (tenant_id, supplier_code, name, contact_person, phone, email, address, payment_term_id, currency_id, status, note, created_by / updated_by).\nsupplier_code is generated server-side (SUP26-nnnn) and is unique per tenant; name is required. Currency drives the PO default and the exchange_rate snapshot taken at PO time.\nNo balance is written \u2014 opening A/P is a manual finance_payables row so the ledger stays the single source of truth (defect D4).",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "INSERT / UPDATE procurement_suppliers (tenant_id, supplier_code, name, contact_person, phone, email, address, payment_term_id, currency_id, status, note, created_by / updated_by).\nsupplier_code is generated server-side (SUP26-nnnn) and is unique per tenant; name is required. Currency drives the PO default and the exchange_rate snapshot taken at PO time.\nNo balance is written \u2014 opening A/P is a manual finance_payables row so the ledger stays the single source of truth (defect D4).",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "YMiv_I3bWzGVlhyN9xgF",
   "type": "text",
   "x": 0,
   "y": 1260,
