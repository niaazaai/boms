   "text": "A/P balance is read from finance_payables (SUM balance_amount per supplier) \u2014 procurement_suppliers stores no balance column.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A/P balance is read from finance_payables (SUM balance_amount per supplier) \u2014 procurement_suppliers stores no balance column.",
