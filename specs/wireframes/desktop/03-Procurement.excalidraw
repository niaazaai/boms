   "locked": false,
   "seed": 1013394624
  },
  {
   "id": "nrHXh-nUvkfBThGiG9E9",
   "type": "text",
   "x": 12,
   "y": 4754,
   "width": 1416,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#be123c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
