  {
   "id": "unLEjahYSprLC0LKCRaY",
   "type": "text",
   "x": 4692,
   "y": 3494,
   "width": 1416,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
