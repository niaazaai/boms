   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 597217491,
   "text": "Post receipt (one transaction): INSERT procurement_receipts (status='posted') + procurement_receipt_items storing quantity_received, unit_cost, allocated_other_cost AND landed_unit_cost (auditable \u2014 defect D1).\nAllocation: allocated_other_cost(line) = header other_cost \u00d7 line_value / \u03a3 line_value; landed_unit_cost = unit_cost + allocated_other_cost / qty. That number \u2014 not unit_cost \u2014 posts to the ledger.\nThen: inventory_stock_transactions type='stock_in', quantity=+recv, unit_cost=landed_unit_cost, reference_type='procurement_receipt'; recompute inventory_items WAC; recompute PO quantity_received; open finance_payables.\nGuard: receiving now > ordered \u2212 already received is BLOCKED unless over_receipt_approved_by is set (screen 9, defect D3).",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Post receipt (one transaction): INSERT procurement_receipts (status='posted') + procurement_receipt_items storing quantity_received, unit_cost, allocated_other_cost AND landed_unit_cost (auditable \u2014 defect D1).\nAllocation: allocated_other_cost(line) = header other_cost \u00d7 line_value / \u03a3 line_value; landed_unit_cost = unit_cost + allocated_other_cost / qty. That number \u2014 not unit_cost \u2014 posts to the ledger.\nThen: inventory_stock_transactions type='stock_in', quantity=+recv, unit_cost=landed_unit_cost, reference_type='procurement_receipt'; recompute inventory_items WAC; recompute PO quantity_received; open finance_payables.\nGuard: receiving now > ordered \u2212 already received is BLOCKED unless over_receipt_approved_by is set (screen 9, defect D3).",
   "autoResize": true,
   "lineHeight": 1.25
  },
