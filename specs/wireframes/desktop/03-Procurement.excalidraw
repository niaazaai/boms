   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 1924303041,
   "text": "Post payment (one transaction): INSERT procurement_supplier_payments (payment_number, supplier_id, amount, currency + exchange_rate, payment_method_id, finance_account_id, paid_at, reference_no)\n\u2192 INSERT finance_transactions (money OUT, posted) and store its id on the payment row so every money movement has exactly one ledger row (defect E2)\n\u2192 UPDATE each allocated finance_payables.paid_amount / balance_amount / status (open \u2192 partial \u2192 paid) \u2192 refresh the cached procurement_purchase_orders.paid_amount, balance_amount, payment_status.\nfinance_accounts balance stays derived (opening_balance + \u03a3 posted finance_transactions); the displayed figure is the cached column refreshed in the same transaction.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Post payment (one transaction): INSERT procurement_supplier_payments (payment_number, supplier_id, amount, currency + exchange_rate, payment_method_id, finance_account_id, paid_at, reference_no)\n\u2192 INSERT finance_transactions (money OUT, posted) and store its id on the payment row so every money movement has exactly one ledger row (defect E2)\n\u2192 UPDATE each allocated finance_payables.paid_amount / balance_amount / status (open \u2192 partial \u2192 paid) \u2192 refresh the cached procurement_purchase_orders.paid_amount, balance_amount, payment_status.\nfinance_accounts balance stays derived (opening_balance + \u03a3 posted finance_transactions); the displayed figure is the cached column refreshed in the same transaction.",
   "autoResize": true,
   "lineHeight": 1.25
  },
