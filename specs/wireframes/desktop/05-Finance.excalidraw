  {
   "id": "z4X8AH0lAs44lsGY_FZ7",
   "type": "text",
   "x": 1848,
   "y": 1772,
   "width": 657.6,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#2563eb",
   "backgroundColor": "transparent",
