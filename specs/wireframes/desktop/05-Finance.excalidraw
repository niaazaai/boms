   "isDeleted": false,
   "boundElements": [],
   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 440280107,
   "text": "THE REVERSAL PAIR (rows 6 and 7) is how correction works everywhere in BOMS.\nFIN26-000437 was posted in error. Voiding it does NOT edit or delete the row \u2014 it inserts\nFIN26-000438, a mirrored row with reverses_id pointing at the original, and flips the\noriginal's status to 'void'. Both stay visible forever; the balance nets to zero.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "THE REVERSAL PAIR (rows 6 and 7) is how correction works everywhere in BOMS.\nFIN26-000437 was posted in error. Voiding it does NOT edit or delete the row \u2014 it inserts\nFIN26-000438, a mirrored row with reverses_id pointing at the original, and flips the\noriginal's status to 'void'. Both stay visible forever; the balance nets to zero.",
   "autoResize": true,
   "lineHeight": 1.25
  },
