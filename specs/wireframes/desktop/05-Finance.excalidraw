   "link": null,
   "locked": false,
   "seed": 925594061,
   "text": "Every row carries amount + exchange_rate + amount_base.\nThe USD supplier payment shows 1,135 USD and 80,000 AFN:\nthe rate was snapshotted at posting, so editing today's rate\nnever restates history.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every row carries amount + exchange_rate + amount_base.\nThe USD supplier payment shows 1,135 USD and 80,000 AFN:\nthe rate was snapshotted at posting, so editing today's rate\nnever restates history.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
