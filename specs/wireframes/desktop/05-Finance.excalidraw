  {
   "id": "uSF_xK9bDnZYqA4US3uB",
   "type": "text",
   "x": 5649.6,
   "y": 2900,
   "width": 430.40000000000003,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#dc2626",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
