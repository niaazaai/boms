  {
   "id": "dfyw7AwQkaUpUq-WUHb9",
   "type": "text",
   "x": 3408,
   "y": 2998,
   "width": 589.44,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
