   "link": null,
   "locked": false,
   "seed": 974716094,
   "text": "White A-Line Gown (ADF26-0042) is reserved 19\u201321 Sep for SO26-000019,\nand blocked until 23 Sep for the 2-day cleaning buffer.\nOnly 1 unit is owned, so it cannot be booked again for 22 Sep.\n\nAvailable alternatives for 22 Sep:\n   \u2022 Ivory Mermaid Gown  ADF26-0088  size S\n   \u2022 Champagne Ball Gown  ADF26-0115  size 40",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "White A-Line Gown (ADF26-0042) is reserved 19\u201321 Sep for SO26-000019,\nand blocked until 23 Sep for the 2-day cleaning buffer.\nOnly 1 unit is owned, so it cannot be booked again for 22 Sep.\n\nAvailable alternatives for 22 Sep:\n   \u2022 Ivory Mermaid Gown  ADF26-0088  size S\n   \u2022 Champagne Ball Gown  ADF26-0115  size 40",
   "autoResize": true,
   "lineHeight": 1.25
  },
