   "text": "Line 3 is free text with no SKU. On POST the system creates the\ninventory_items row, generates SKU ADF26-0131 from platform_sequences,\nand writes the new id back onto the PO line and this receipt line.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
