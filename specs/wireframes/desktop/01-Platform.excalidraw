  {
   "id": "9OEVBrtxyMj7iTXaQOoU",
   "type": "text",
   "x": 1848,
   "y": 1724,
   "width": 1112,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
