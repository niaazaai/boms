   "text": "Both the barcode and the QR carry the order number SO26-000020. One scan at the returns desk opens the ticket \u2014 no phone search, no typing.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both the barcode and the QR carry the order number SO26-000020. One scan at the returns desk opens the ticket \u2014 no phone search, no typing.",
   "autoResize": true,
   "lineHeight": 1.25
  },
