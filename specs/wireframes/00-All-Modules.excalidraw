   "link": null,
   "locked": false,
   "seed": 2092281397,
   "text": "Every row links to the document that caused it \u2014 there is no way to move money without a source document. Deposit rows are tinted:\nthey change cash but carry is_deposit_movement = true and no income category, so they never reach the Income pillar or the P&L.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every row links to the document that caused it \u2014 there is no way to move money without a source document. Deposit rows are tinted:\nthey change cash but carry is_deposit_movement = true and no income category, so they never reach the Income pillar or the P&L.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
