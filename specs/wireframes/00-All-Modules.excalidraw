   "text": "READS sales_order_items WHERE line_type='rental' JOIN sales_orders (status IN 'returned','completed')\nGROUP BY inventory_item_id. Times rented = COUNT(lines). Avg days = AVG(rental_end \u2212 rental_start).\nUtilisation % = \u03a3 rental days \u00f7 (days in period \u2212 days blocked by cleaning buffer \u2212 days disposed).\nLate returns = COUNT(actual_return_date > rental_end_date). Claims = sales_rental_claims by item.\nAmortised % = accumulated per-use rental COGS \u00f7 purchase_cost \u2014 shows the asset being consumed.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "READS sales_order_items WHERE line_type='rental' JOIN sales_orders (status IN 'returned','completed')\nGROUP BY inventory_item_id. Times rented = COUNT(lines). Avg days = AVG(rental_end \u2212 rental_start).\nUtilisation % = \u03a3 rental days \u00f7 (days in period \u2212 days blocked by cleaning buffer \u2212 days disposed).\nLate returns = COUNT(actual_return_date > rental_end_date). Claims = sales_rental_claims by item.\nAmortised % = accumulated per-use rental COGS \u00f7 purchase_cost \u2014 shows the asset being consumed.",
   "autoResize": true,
   "lineHeight": 1.25
  },
