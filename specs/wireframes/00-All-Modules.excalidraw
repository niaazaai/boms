  {
   "id": "AKEMZIQDpLIPaeCGq7NA",
   "type": "text",
   "x": 3408,
   "y": 48439.625,
   "width": 680.32,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
