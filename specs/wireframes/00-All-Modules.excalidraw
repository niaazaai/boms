   "index": "a0",
   "roundness": null,
   "version": 1,
   "versionNonce": 1274709145,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 2013576840,
   "text": "Post debit note (one transaction): INSERT procurement_returns + return items (receipt_item_id, inventory_item_id, quantity, landed_unit_cost, reason) \u00b7\ninventory_stock_transactions type='stock_out', quantity=\u22121, unit_cost = landed_unit_cost, reference_type='procurement_return' \u00b7\nUPDATE finance_payables (AP26-0042 original 107,068.00 \u2192 88,258.00) + reversing finance_transactions row \u00b7 refresh the PO balance cache (defect D7).\nA return NEVER edits the original receipt \u2014 posted receipts stay immutable.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Post debit note (one transaction): INSERT procurement_returns + return items (receipt_item_id, inventory_item_id, quantity, landed_unit_cost, reason) \u00b7\ninventory_stock_transactions type='stock_out', quantity=\u22121, unit_cost = landed_unit_cost, reference_type='procurement_return' \u00b7\nUPDATE finance_payables (AP26-0042 original 107,068.00 \u2192 88,258.00) + reversing finance_transactions row \u00b7 refresh the PO balance cache (defect D7).\nA return NEVER edits the original receipt \u2014 posted receipts stay immutable.",
   "autoResize": true,
   "lineHeight": 1.25
  },
