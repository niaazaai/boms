  {
   "id": "myNz4_effUGN_hZDhfRB",
   "type": "text",
   "x": 4968,
   "y": 15147.625,
   "width": 1112,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
