   "seed": 2005344580,
   "text": "RESERVED IS NOT A MOVEMENT\nreserved_qty = \u03a3 active reservations.\nNothing is written to the stock ledger until the\ndress physically leaves the shop as rent_out.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "RESERVED IS NOT A MOVEMENT\nreserved_qty = \u03a3 active reservations.\nNothing is written to the stock ledger until the\ndress physically leaves the shop as rent_out.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
