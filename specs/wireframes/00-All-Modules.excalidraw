  {
   "id": "8DtEeNhYOZjD2-54V238",
   "type": "text",
   "x": 4045.44,
   "y": 38541.625,
   "width": 474.55999999999995,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#7c3aed",
   "backgroundColor": "transparent",
