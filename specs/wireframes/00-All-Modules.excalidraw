   "seed": 548299755,
   "text": "A/R opens when an order completes with a balance, or when a rental claim (damage / loss / late) charges a customer beyond their deposit \u2014 row 4 shows exactly that case.\nsales_orders.cached_balance_amount mirrors this for display only. Collecting posts a finance_transactions IN, reduces the receivable, and updates the order's cache.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A/R opens when an order completes with a balance, or when a rental claim (damage / loss / late) charges a customer beyond their deposit \u2014 row 4 shows exactly that case.\nsales_orders.cached_balance_amount mirrors this for display only. Collecting posts a finance_transactions IN, reduces the receivable, and updates the order's cache.",
   "autoResize": true,
   "lineHeight": 1.25
  },
