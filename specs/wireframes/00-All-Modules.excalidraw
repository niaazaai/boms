  {
   "id": "KxpIltKqvdVdmHEGKrxG",
   "type": "text",
   "x": 4692,
   "y": 23101.625,
   "width": 1416,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
