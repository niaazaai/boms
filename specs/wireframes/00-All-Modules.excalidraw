   "isDeleted": false,
   "boundElements": [],
   "updated": 1789469969945,
   "link": null,
   "locked": false,
   "seed": 1431585588,
   "text": "A/P is opened by procurement_receipts on post and reduced by procurement_supplier_payments and procurement_returns.\nprocurement_purchase_orders.cached_balance_amount mirrors this for display and is NEVER summed for the pillar \u2014 in v1 both tables held the number\nwith no reconciliation, so the dashboard and the PO list were guaranteed to drift apart. Aging buckets come from due_date vs the current business_date.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A/P is opened by procurement_receipts on post and reduced by procurement_supplier_payments and procurement_returns.\nprocurement_purchase_orders.cached_balance_amount mirrors this for display and is NEVER summed for the pillar \u2014 in v1 both tables held the number\nwith no reconciliation, so the dashboard and the PO list were guaranteed to drift apart. Aging buckets come from due_date vs the current business_date.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
