   "seed": 2133682602,
   "text": "WRITES sales_orders: status='returned', actual_return_date, late_days, late_fee_amount=2,000,\nlate_fee_waived_amount=500 + waiver reason, return_condition='needs_cleaning'.\ninventory_stock_transactions type='rent_return' (qty back) \u00b7 inventory_reservations released \u00b7\navailability blocked until actual_return_date + cleaning_buffer_days.\nfinance_customer_deposits: 1,500 applied \u2192 finance_receivables, 4,500 refunded \u2192 finance_transactions OUT,\n0 forfeited. ONLY the forfeited slice ever posts to Income. Condition 'damaged'/'lost' opens sales_rental_claims instead.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WRITES sales_orders: status='returned', actual_return_date, late_days, late_fee_amount=2,000,\nlate_fee_waived_amount=500 + waiver reason, return_condition='needs_cleaning'.\ninventory_stock_transactions type='rent_return' (qty back) \u00b7 inventory_reservations released \u00b7\navailability blocked until actual_return_date + cleaning_buffer_days.\nfinance_customer_deposits: 1,500 applied \u2192 finance_receivables, 4,500 refunded \u2192 finance_transactions OUT,\n0 forfeited. ONLY the forfeited slice ever posts to Income. Condition 'damaged'/'lost' opens sales_rental_claims instead.",
   "autoResize": true,
   "lineHeight": 1.25
  },
