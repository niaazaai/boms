  {
   "id": "gUvD1ul8ICvjCB6kPE6N",
   "type": "text",
   "x": 0,
   "y": 11923.625,
   "width": 3400,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
