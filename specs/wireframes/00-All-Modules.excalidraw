  {
   "id": "NCuJsJK_XEgH4lP5ebyT",
   "type": "text",
   "x": 12,
   "y": 21841.625,
   "width": 1416,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#0d9488",
