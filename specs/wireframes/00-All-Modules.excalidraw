   "seed": 91374315,
   "text": "Send  \u2192 inventory_stock_transactions type=transfer_out (negative) at the SOURCE warehouse's weighted-average cost.\nReceive \u2192 type=transfer_in (positive) at that SAME unit cost, so an internal move never creates or destroys value.\nPartial receive is supported via inventory_transfer_items.received_quantity. Goods in transit are shown separately from on-hand and are still Owned for valuation.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Send  \u2192 inventory_stock_transactions type=transfer_out (negative) at the SOURCE warehouse's weighted-average cost.\nReceive \u2192 type=transfer_in (positive) at that SAME unit cost, so an internal move never creates or destroys value.\nPartial receive is supported via inventory_transfer_items.received_quantity. Goods in transit are shown separately from on-hand and are still Owned for valuation.",
   "autoResize": true,
   "lineHeight": 1.25
  },
