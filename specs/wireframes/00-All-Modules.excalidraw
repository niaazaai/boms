  {
   "id": "j1SelLQJ3EuMq5faONEh",
   "type": "text",
   "x": 1848,
   "y": 15147.625,
   "width": 1112,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "xTiFFB3cMqlyO9q20uqE"
   ],
   "frameId": null,
   "index": "a0",
   "roundness": null,
   "version": 1,
   "versionNonce": 998373355,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789469969945,
   "link": null,
   "locked": false,
   "seed": 709381331,
   "text": "Reads inventory_reservations WHERE inventory_item_id = :id, with the customer and order joined in. Writes nothing \u2014 \uff0b Reserve opens the drawer on D2.\nblocked_until = reserved_to + cleaning buffer days, so the turnaround sits inside the guarded range and the next customer cannot book the gown straight out of a wedding.\nDouble-booking is prevented by the EXCLUDE constraint (ADR-010), not by application code \u2014 see the note on D1.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Reads inventory_reservations WHERE inventory_item_id = :id, with the customer and order joined in. Writes nothing \u2014 \uff0b Reserve opens the drawer on D2.\nblocked_until = reserved_to + cleaning buffer days, so the turnaround sits inside the guarded range and the next customer cannot book the gown straight out of a wedding.\nDouble-booking is prevented by the EXCLUDE constraint (ADR-010), not by application code \u2014 see the note on D1.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
