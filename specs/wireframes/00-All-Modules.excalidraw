   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 125200218,
   "text": "Seven actions, deliberately including POST and VOID \u2014 the two that move stock and money.\nv1 listed only view/create/edit/void/export/approve, so 'who may post a receipt or void a\npayment' had no permission to attach to. Effective permissions for a user are the UNION\nacross all their roles. Select-all is available per row and per column.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Seven actions, deliberately including POST and VOID \u2014 the two that move stock and money.\nv1 listed only view/create/edit/void/export/approve, so 'who may post a receipt or void a\npayment' had no permission to attach to. Effective permissions for a user are the UNION\nacross all their roles. Select-all is available per row and per column.",
   "autoResize": true,
   "lineHeight": 1.25
  },
