   "seed": 1829242099,
   "text": "READS sales_customers + sales_orders + sales_order_payments + finance_customer_deposits + finance_receivables.\nThe deposit ledger is the audit trail for the liability: held \u2192 applied | forfeited | refunded.\nONLY the 'forfeited' rows ever appear in Income. 'held' is money the shop is holding, not money it earned.\nBalance column is display-only; the authoritative open amount is the finance_receivables row per order.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "READS sales_customers + sales_orders + sales_order_payments + finance_customer_deposits + finance_receivables.\nThe deposit ledger is the audit trail for the liability: held \u2192 applied | forfeited | refunded.\nONLY the 'forfeited' rows ever appear in Income. 'held' is money the shop is holding, not money it earned.\nBalance column is display-only; the authoritative open amount is the finance_receivables row per order.",
   "autoResize": true,
   "lineHeight": 1.25
  },
