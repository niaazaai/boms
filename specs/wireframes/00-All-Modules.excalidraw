   "seed": 1441727426,
   "text": "Home mirrors the Finance pillars so the owner sees the day's answer without opening a module. Reads finance_daily_summaries (or live when stale),\nsales_orders by rental_end_date for the schedule, and inventory_stock_balances for low stock. Every tile deep-links into its module.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Home mirrors the Finance pillars so the owner sees the day's answer without opening a module. Reads finance_daily_summaries (or live when stale),\nsales_orders by rental_end_date for the schedule, and inventory_stock_balances for low stock. Every tile deep-links into its module.",
   "autoResize": true,
   "lineHeight": 1.25
  },
