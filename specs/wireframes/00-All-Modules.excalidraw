   "roundness": null,
   "version": 1,
   "versionNonce": 1056170622,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789469969945,
   "link": null,
   "locked": false,
   "seed": 492434396,
   "text": "Read top to bottom: A Dashboard \u00b7 B Items (list \u2192 drawers \u2192 the six profile tabs) \u00b7 C Stock ledger \u00b7 D Reservations \u00b7 E Transfers \u00b7 F Reports.\nBarcode and QR are generated from the SKU \u00b7 no Purpose field \u00b7 rentals have no fixed period \u00b7 every create and edit is a drawer over its list.\nOwned = on hand + on rent (valuation) \u00b7 Available = on hand \u2212 reserved \u00b7 reservations are not ledger rows \u00b7 weighted average cost \u00b7 immutable postings",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Read top to bottom: A Dashboard \u00b7 B Items (list \u2192 drawers \u2192 the six profile tabs) \u00b7 C Stock ledger \u00b7 D Reservations \u00b7 E Transfers \u00b7 F Reports.\nBarcode and QR are generated from the SKU \u00b7 no Purpose field \u00b7 rentals have no fixed period \u00b7 every create and edit is a drawer over its list.\nOwned = on hand + on rent (valuation) \u00b7 Available = on hand \u2212 reserved \u00b7 reservations are not ledger rows \u00b7 weighted average cost \u00b7 immutable postings",
   "autoResize": true,
   "lineHeight": 1.25
  },
