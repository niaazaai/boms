   "isDeleted": false,
   "boundElements": [],
   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 6475545,
   "text": "READS procurement_purchase_orders JOIN procurement_suppliers, with line aggregates from procurement_purchase_order_items and A/P from finance_payables.\nquantity_received is RECOMPUTED from procurement_receipt_items (never incremented in place), so the % column cannot drift from the receipts (defect D3).\nStatus chips filter status enum(draft, ordered, partial_received, received, cancelled). A PO that has any posted receipt can no longer be cancelled \u2014 use a supplier return instead.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "READS procurement_purchase_orders JOIN procurement_suppliers, with line aggregates from procurement_purchase_order_items and A/P from finance_payables.\nquantity_received is RECOMPUTED from procurement_receipt_items (never incremented in place), so the % column cannot drift from the receipts (defect D3).\nStatus chips filter status enum(draft, ordered, partial_received, received, cancelled). A PO that has any posted receipt can no longer be cancelled \u2014 use a supplier return instead.",
   "autoResize": true,
   "lineHeight": 1.25
  },
