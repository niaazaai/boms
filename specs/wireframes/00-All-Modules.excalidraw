   "version": 1,
   "versionNonce": 2040694306,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789469969945,
   "link": null,
   "locked": false,
   "seed": 1929482282,
   "text": "Read-only dashboard \u2014 writes nothing. Reads inventory_stock_balances (view) for on-hand / on-rent / reserved / available / avg cost, inventory_stock_transactions for recent movements,\nand inventory_reservations for upcoming bookings and conflicts. Stock worth = \u03a3(owned_qty \u00d7 avg_unit_cost) where owned = on hand + on rent \u2014 a gown out on rent is still an asset and must be valued.\nAvailable = on hand \u2212 reserved. Reserved is read from inventory_reservations (status=active) \u2014 it is NOT a stock movement and never appears in the ledger.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Read-only dashboard \u2014 writes nothing. Reads inventory_stock_balances (view) for on-hand / on-rent / reserved / available / avg cost, inventory_stock_transactions for recent movements,\nand inventory_reservations for upcoming bookings and conflicts. Stock worth = \u03a3(owned_qty \u00d7 avg_unit_cost) where owned = on hand + on rent \u2014 a gown out on rent is still an asset and must be valued.\nAvailable = on hand \u2212 reserved. Reserved is read from inventory_reservations (status=active) \u2014 it is NOT a stock movement and never appears in the ledger.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
