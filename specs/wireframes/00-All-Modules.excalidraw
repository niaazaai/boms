   "seed": 2060589617,
   "text": "READS inventory_reservations JOIN sales_orders. A dress is unavailable when the requested window\noverlaps [rental_start_date, rental_end_date + cleaning_buffer_days] of any reservation whose order\nstatus IN ('confirmed','out') \u2014 the buffer is part of the block, not a suggestion.\nNo write happens until the clash is resolved: Confirm is refused rather than double-booking the gown.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "READS inventory_reservations JOIN sales_orders. A dress is unavailable when the requested window\noverlaps [rental_start_date, rental_end_date + cleaning_buffer_days] of any reservation whose order\nstatus IN ('confirmed','out') \u2014 the buffer is part of the block, not a suggestion.\nNo write happens until the clash is resolved: Confirm is refused rather than double-booking the gown.",
   "autoResize": true,
   "lineHeight": 1.25
  },
