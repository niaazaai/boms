   "seed": 149838175,
   "text": "Received % = SUM(quantity_received) / SUM(quantity_ordered) over procurement_purchase_order_items \u00b7 Balance is the derived display of finance_payables.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Received % = SUM(quantity_received) / SUM(quantity_ordered) over procurement_purchase_order_items \u00b7 Balance is the derived display of finance_payables.",
   "autoResize": true,
   "lineHeight": 1.25
  },
