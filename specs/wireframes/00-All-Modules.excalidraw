  {
   "id": "1bq9CCAES5JFH0nP5hT0",
   "type": "text",
   "x": 1572,
   "y": 24361.625,
   "width": 1416,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#0d9488",
   "backgroundColor": "transparent",
