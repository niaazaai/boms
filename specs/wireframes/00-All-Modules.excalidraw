  {
   "id": "554El7KYmfCqfV5nSut7",
   "type": "text",
   "x": 12,
   "y": 24361.625,
   "width": 1416,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#be123c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
