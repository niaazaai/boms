  },
  {
   "id": "a_x2iZ-yBDIcdUakpU2V",
   "type": "text",
   "x": 1064,
   "y": 23991.625,
   "width": 332,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "eaqzxmMkDTaSzEhO7_B0"
   ],
   "frameId": null,
   "index": "a0",
   "roundness": null,
   "version": 1,
   "versionNonce": 95762384,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789320956557,
   "link": null,
   "locked": false,
   "seed": 448005,
   "text": "\u2022 Only lines from a POSTED receipt\n  can be returned.\n\u2022 Return qty \u2264 received qty minus\n  quantity already returned.\n\u2022 Credit is always at landed unit\n  cost \u2014 never at the raw unit cost.\n\u2022 Posting is irreversible; correct it\n  with a second debit note.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022 Only lines from a POSTED receipt\n  can be returned.\n\u2022 Return qty \u2264 received qty minus\n  quantity already returned.\n\u2022 Credit is always at landed unit\n  cost \u2014 never at the raw unit cost.\n\u2022 Posting is irreversible; correct it\n  with a second debit note.",
   "autoResize": true,
   "lineHeight": 1.25
  },
