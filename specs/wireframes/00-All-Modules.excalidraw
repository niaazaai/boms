   "seed": 1686664402,
   "text": "READS ONLY. Revenue KPI = \u03a3 sales_order_items.line_total for the day (sale + rental lines).\nDeposits held = \u03a3 finance_customer_deposits.status='held' \u2014 a liability tile, never summed into revenue.\nDue back today = sales_orders WHERE status='out' AND rental_end_date = today. Overdue = rental_end_date < today.\nUnpaid A/R = \u03a3 finance_receivables.balance_amount WHERE status IN ('open','partial') \u2014 never sales_orders.balance_amount.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "READS ONLY. Revenue KPI = \u03a3 sales_order_items.line_total for the day (sale + rental lines).\nDeposits held = \u03a3 finance_customer_deposits.status='held' \u2014 a liability tile, never summed into revenue.\nDue back today = sales_orders WHERE status='out' AND rental_end_date = today. Overdue = rental_end_date < today.\nUnpaid A/R = \u03a3 finance_receivables.balance_amount WHERE status IN ('open','partial') \u2014 never sales_orders.balance_amount.",
   "autoResize": true,
   "lineHeight": 1.25
  },
