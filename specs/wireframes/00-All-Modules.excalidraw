   "seed": 535140831,
   "text": "MANDATORY audited events: every post, every void (with its void_reason), permission and role changes, tenant setting changes, price changes, login and logout.\nv1 scoped the audit log to 'login + critical settings changes', which left the two actions an owner most needs to trace \u2014 who moved stock, who moved money \u2014 unrecorded.\nbefore_json / after_json capture the change itself, so row 4 shows the exact setting transition and row 6 shows the permission that was granted.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "MANDATORY audited events: every post, every void (with its void_reason), permission and role changes, tenant setting changes, price changes, login and logout.\nv1 scoped the audit log to 'login + critical settings changes', which left the two actions an owner most needs to trace \u2014 who moved stock, who moved money \u2014 unrecorded.\nbefore_json / after_json capture the change itself, so row 4 shows the exact setting transition and row 6 shows the permission that was granted.",
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "spec": true
   }
  },
