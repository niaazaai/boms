   "type": "text",
   "x": 3698.0,
   "y": 37059.625,
   "width": 532,
   "height": 130.0,
   "angle": 0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
