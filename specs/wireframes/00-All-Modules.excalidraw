   "seed": 138617242,
   "text": "Comparison reads finance_daily_summaries where fresh, falling back to a live query when is_stale = true. The snapshot is a CACHE, never a source of truth \u2014\na back-dated expense flips is_stale on every covered date so the figure is recomputed rather than silently served stale.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Comparison reads finance_daily_summaries where fresh, falling back to a live query when is_stale = true. The snapshot is a CACHE, never a source of truth \u2014\na back-dated expense flips is_stale on every covered date so the figure is recomputed rather than silently served stale.",
   "autoResize": true,
   "lineHeight": 1.25
  },
