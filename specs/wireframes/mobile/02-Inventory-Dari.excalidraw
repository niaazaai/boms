   "updated": 1789469969945,
   "link": null,
   "locked": false,
   "seed": 2049228595,
   "text": "\u0647\u0645\u0627\u0646 \u062a\u062e\u062a\u0647\u0654 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0622\u06cc\u0646\u0647 \u0634\u062f\u0647 \u0648 \u062a\u0631\u062c\u0645\u0647 \u06af\u0631\u062f\u06cc\u062f\u0647: \u06cc\u06a9 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0631 \u0637\u0631\u062d\u060c \u0647\u0631 \u0633\u0647 \u0646\u0633\u062e\u0647 \u0631\u0627 \u062a\u0627\u0632\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f.\n\u0642\u0644\u0645 \u062a\u0648\u0644\u06cc\u062f\u06cc Vazirmatn \u0627\u0633\u062a. \u0627\u06a9\u0633\u0644\u06cc\u062f\u0631\u0627 \u0641\u0648\u0646\u062a \u0633\u0641\u0627\u0631\u0634\u06cc \u0631\u0627 \u062c\u0627\u0633\u0627\u0632\u06cc \u06a9\u0631\u062f\u0647 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0627\u06cc\u0646\u062c\u0627 \u0642\u0644\u0645 \u0633\u06cc\u0633\u062a\u0645 \u0628\u0647 \u06a9\u0627\u0631 \u0631\u0641\u062a\u0647 \u2014\n\u0642\u0644\u0645 \u062f\u0642\u06cc\u0642 \u062f\u0631 specs/design/tokens/typography.json \u062b\u0628\u062a \u0627\u0633\u062a.\n\u0627\u0639\u062f\u0627\u062f\u060c \u0645\u0628\u0627\u0644\u063a\u060c SKU\u060c \u0628\u0627\u0631\u06a9\u062f \u0648 \u0634\u0645\u0627\u0631\u0647 \u0627\u0633\u0646\u0627\u062f \u0686\u067e\u200c\u0686\u06cc\u0646 \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f. \u06a9\u0627\u062f\u0631\u0647\u0627\u06cc \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0639\u0645\u062f\u0627\u064b \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc\u200c\u0627\u0646\u062f: \u0622\u0646\u200c\u0647\u0627 \u0646\u0627\u0645 \u062c\u062f\u0648\u0644\u200c\u0647\u0627 \u0648 SQL \u0631\u0627\n\u0628\u0631\u0627\u06cc \u062a\u06cc\u0645 \u0627\u0646\u06a9\u0634\u0627\u0641 \u0645\u06cc\u200c\u0646\u0648\u06cc\u0633\u0646\u062f\u060c \u0646\u0647 \u0645\u062a\u0646 \u0631\u0627\u0628\u0637 \u06a9\u0627\u0631\u0628\u0631.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "right",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u0647\u0645\u0627\u0646 \u062a\u062e\u062a\u0647\u0654 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0622\u06cc\u0646\u0647 \u0634\u062f\u0647 \u0648 \u062a\u0631\u062c\u0645\u0647 \u06af\u0631\u062f\u06cc\u062f\u0647: \u06cc\u06a9 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0631 \u0637\u0631\u062d\u060c \u0647\u0631 \u0633\u0647 \u0646\u0633\u062e\u0647 \u0631\u0627 \u062a\u0627\u0632\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f.\n\u0642\u0644\u0645 \u062a\u0648\u0644\u06cc\u062f\u06cc Vazirmatn \u0627\u0633\u062a. \u0627\u06a9\u0633\u0644\u06cc\u062f\u0631\u0627 \u0641\u0648\u0646\u062a \u0633\u0641\u0627\u0631\u0634\u06cc \u0631\u0627 \u062c\u0627\u0633\u0627\u0632\u06cc \u06a9\u0631\u062f\u0647 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0627\u06cc\u0646\u062c\u0627 \u0642\u0644\u0645 \u0633\u06cc\u0633\u062a\u0645 \u0628\u0647 \u06a9\u0627\u0631 \u0631\u0641\u062a\u0647 \u2014\n\u0642\u0644\u0645 \u062f\u0642\u06cc\u0642 \u062f\u0631 specs/design/tokens/typography.json \u062b\u0628\u062a \u0627\u0633\u062a.\n\u0627\u0639\u062f\u0627\u062f\u060c \u0645\u0628\u0627\u0644\u063a\u060c SKU\u060c \u0628\u0627\u0631\u06a9\u062f \u0648 \u0634\u0645\u0627\u0631\u0647 \u0627\u0633\u0646\u0627\u062f \u0686\u067e\u200c\u0686\u06cc\u0646 \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f. \u06a9\u0627\u062f\u0631\u0647\u0627\u06cc \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0639\u0645\u062f\u0627\u064b \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc\u200c\u0627\u0646\u062f: \u0622\u0646\u200c\u0647\u0627 \u0646\u0627\u0645 \u062c\u062f\u0648\u0644\u200c\u0647\u0627 \u0648 SQL \u0631\u0627\n\u0628\u0631\u0627\u06cc \u062a\u06cc\u0645 \u0627\u0646\u06a9\u0634\u0627\u0641 \u0645\u06cc\u200c\u0646\u0648\u06cc\u0633\u0646\u062f\u060c \u0646\u0647 \u0645\u062a\u0646 \u0631\u0627\u0628\u0637 \u06a9\u0627\u0631\u0628\u0631.",
   "autoResize": true,
   "lineHeight": 1.25
  },
