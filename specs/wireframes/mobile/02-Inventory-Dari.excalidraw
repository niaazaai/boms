   "text": "\u0628\u0647 \u0647\u0645\u0627\u0646 \u062a\u0631\u062a\u06cc\u0628 \u062a\u062e\u062a\u0647\u0654 \u062f\u0633\u06a9\u062a\u0627\u067e: \u0627\u0644\u0641 \u062f\u0627\u0634\u0628\u0648\u0631\u062f \u00b7 \u0628 \u0627\u0642\u0644\u0627\u0645 \u0648 \u0632\u0628\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u067e\u0631\u0648\u0641\u0627\u06cc\u0644 \u00b7 \u062c \u062f\u0641\u062a\u0631 \u00b7 \u062f \u0631\u0632\u0631\u0648\u0647\u0627 \u00b7 \u0647\u0640 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u00b7 \u0648 \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "right",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u0628\u0647 \u0647\u0645\u0627\u0646 \u062a\u0631\u062a\u06cc\u0628 \u062a\u062e\u062a\u0647\u0654 \u062f\u0633\u06a9\u062a\u0627\u067e: \u0627\u0644\u0641 \u062f\u0627\u0634\u0628\u0648\u0631\u062f \u00b7 \u0628 \u0627\u0642\u0644\u0627\u0645 \u0648 \u0632\u0628\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u067e\u0631\u0648\u0641\u0627\u06cc\u0644 \u00b7 \u062c \u062f\u0641\u062a\u0631 \u00b7 \u062f \u0631\u0632\u0631\u0648\u0647\u0627 \u00b7 \u0647\u0640 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u00b7 \u0648 \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627.",
